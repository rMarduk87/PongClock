<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/menuFragment">

    <fragment
        android:id="@+id/menuFragment"
        android:name="rpt.tool.pongclock.ui.menu.MenuFragment"
        android:label="MenuFragment">
        <action
            android:id="@+id/action_menuFragment_to_clockFragment"
            app:destination="@id/clockFragment" />
        <action
            android:id="@+id/action_menuFragment_to_breakOutClockFragment"
            app:destination="@id/breakOutClockFragment" />
        <action
            android:id="@+id/action_menuFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/clockFragment"
        android:name="rpt.tool.pongclock.ui.clock.ClockFragment"
        android:label="ClockFragment">
        <action
            android:id="@+id/action_clockFragment_to_breakOutClockFragment"
            app:destination="@id/breakOutClockFragment"
            app:popUpTo="@id/clockFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/breakOutClockFragment"
        android:name="rpt.tool.pongclock.ui.breakout.BreakOutClockFragment"
        android:label="BreakOutClockFragment" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="rpt.tool.pongclock.ui.settings.SettingsFragment"
        android:label="SettingsFragment" />
</navigation>
